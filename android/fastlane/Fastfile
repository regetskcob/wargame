# Uploads Panzergefecht to Google Play. Run from android/ after
# `flutter build appbundle --release`, see store/android/README.md.

default_platform(:android)

METADATA = File.expand_path("../../store/android/metadata/android", __dir__)
BUNDLE = File.expand_path(
  "../../build/app/outputs/bundle/release/app-release.aab", __dir__
)

# Play keeps the Wear OS releases on tracks of their own, named
# "wear:internal", "wear:production" and so on.
def track_for(track, form_factor)
  form_factor.to_s == "wear" ? "wear:#{track}" : track
end

platform :android do
  desc "Checks the key and the metadata without changing anything"
  lane :validate do
    validate_play_store_json_key
    upload_to_play_store(
      track: "internal",
      aab: BUNDLE,
      metadata_path: METADATA,
      validate_only: true
    )
  end

  desc "Uploads the bundle to a track (internal, alpha, beta, production)"
  desc "form_factor:wear sends the Wear OS bundle to the watch's own track"
  lane :deploy do |options|
    upload_to_play_store(
      track: track_for(options.fetch(:track, "internal"), options[:form_factor]),
      aab: BUNDLE,
      metadata_path: METADATA,
      skip_upload_metadata: !options[:metadata],
      skip_upload_images: !options[:metadata],
      skip_upload_screenshots: !options[:metadata],
      # A draft until the store listing, the content rating and Data safety
      # are complete. Afterwards pass release_status:completed.
      release_status: options.fetch(:release_status, "draft")
    )
  end

  desc "Uploads only the store texts, icon and screenshots"
  lane :metadata do
    upload_to_play_store(
      metadata_path: METADATA,
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_changelogs: true
    )
  end

  desc "Moves the latest release from one track to another"
  lane :promote do |options|
    upload_to_play_store(
      track: track_for(options.fetch(:from, "internal"), options[:form_factor]),
      track_promote_to: track_for(options.fetch(:to, "alpha"), options[:form_factor]),
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    )
  end
end
