<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- While the process starts: the launch screen, removed when Flutter
         draws its first frame, the loading view. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Behind the Flutter UI, seen while it starts: the ground colour
         instead of white. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_ground</item>
    </style>
</resources>
