<?xml version="1.0" encoding="utf-8"?>
<!-- Before Android 12: the tank of the launch screen on the colour of its
     ground, until Flutter draws the loading view in the same place. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_ground" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_tank" />
    </item>
</layer-list>
