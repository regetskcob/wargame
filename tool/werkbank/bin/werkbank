#!/usr/bin/env bash
# werkbank – shared build, release and screenshot steps of the app repos.
#
#   werkbank layout                    folder structure as in STANDARD.md
#   werkbank verify [--quick]          layout, l10n, format, analyze, tests, then the
#                                      project's verify_extra (skipped with --quick)
#   werkbank version [name|build]      version from pubspec.yaml
#   werkbank android [-- <flutter args>]
#                                      signed AAB, checked against the debug key,
#                                      copied to build/release/
#   werkbank ios [--upload] [-- <flutter args>]
#                                      IPA, copied to build/release/; --upload sends
#                                      it to App Store Connect (API key)
#   werkbank site <folder> <base URL> [blog <subfolder> [--push]]
#                                      build a Hugo site into build/site/<folder>/,
#                                      optionally copy it into the blog repository
#   werkbank collect aab|apk|ipa <path> [variant]
#                                      take a bundle built elsewhere (fastlane) into
#                                      build/release/, AAB/APK checked like above
#   werkbank symbols <platform>        keep build/symbols/<platform> outside the repo
#   werkbank sim <name> <device type> <runtime>
#                                      find or create the simulator, boot it, print
#                                      its UDID (e.g. "Store iPhone 6.9"
#                                      com.apple.CoreSimulator.SimDeviceType.iPhone-16-Pro-Max iOS)
#   werkbank changelog [--draft] [version]
#                                      CHANGELOG.md and CHANGELOG.<lang>.md have a finished
#                                      section "## <version> – <date>"; --draft turns
#                                      "## Unreleased" into it or drafts it from merged PRs
#   werkbank notes [--draft] [build]   release texts of the build complete? (TestFlight per
#                                      language, Play block ≤ 500); --draft creates drafts
#                                      from the merged pull requests; Play block to the clipboard
#   werkbank upload-apple <xcarchive>  to App Store Connect with the Xcode account (no API key)
#   werkbank upload-play [aab] [track] to a Play track with the release notes (service account)
#   werkbank devicetest [--device <id>] [test …]
#                                      integration tests on every connected device in turn,
#                                      report in build/devicetest/<time>/report.md
#   werkbank release [--dry-run] [--upload] [--only <product>]
#                                      the release, same phases everywhere: preflight, build
#                                      (and upload), tag, GitHub release, sites, report
#   werkbank site-deploy <name|all> [--live]
#                                      build a site of WB_SITES; --live deploys it to its target
#   werkbank resolved                  fails while a store build left ios/ or macos/
#                                      Package.resolved changed (commit them via PR)
#   werkbank push [git push args]      git push, then mark HEAD verified on GitHub
#                                      (status werkbank/verify) when verify passed for it
#   werkbank push-tag <tag>            push the tag, mark the tagged commit the same way
#   werkbank doctor                    which tools and keys are there
#
# Works from any directory: a copy in tool/werkbank/ always acts on its own
# project. Project settings come from
# tool/werkbank.conf (a bash file, see STANDARD.md); tool/werkbank/ itself is a
# copy of the werkbank repository and is never edited in the project.
set -euo pipefail

# shellcheck source-path=SCRIPTDIR/..
# shellcheck source=lib/common.sh
. "$(dirname "${BASH_SOURCE[0]}")/../lib/common.sh"

wb_enter_repo
wb_load_conf

cmd="${1:-}"
[ $# -gt 0 ] && shift
case "$cmd" in
  layout) wb_layout ;;
  verify) wb_verify "$@" ;;
  version) wb_version "${1:-}" ;;
  android) wb_android "$@" ;;
  ios) wb_ios "$@" ;;
  collect) wb_collect "$@" ;;
  symbols) wb_symbols "${1:?platform}" ;;
  site)
    out=$(wb_site_build "${1:?site folder}" "${2:?base URL}")
    say "Built $out"
    if [ "${3:-}" = blog ]; then wb_site_blog "$out" "${4:?folder below static/}" "${@:5}"; fi
    ;;
  sim) wb_sim "$@" ;;
  changelog) wb_changelog "$@" ;;
  notes) wb_store_notes "$@" ;;
  upload-apple) wb_upload_apple "$@" ;;
  upload-play) wb_upload_play "$@" ;;
  devicetest) wb_devicetest "$@" ;;
  release) wb_release "$@" ;;
  site-deploy) wb_site_deploy "$@" ;;
  resolved) wb_resolved_guard && say "Package.resolved unchanged" ;;
  push) wb_push "$@" ;;
  push-tag) wb_push_tag "$@" ;;
  doctor) wb_doctor ;;
  *) sed -n '2,50p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
