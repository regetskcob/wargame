# Uploads the store texts and screenshots of Panzergefecht to App Store
# Connect. Run from ios/ with an App Store Connect API key in ASC_KEY_ID,
# ASC_ISSUER_ID and ASC_KEY_PATH, see store/ios/README.md:
#
#   bundle exec fastlane ios metadata
#
# The builds themselves are archived and uploaded on this Mac by
# tool/archive_ios.sh and tool/archive_apple.sh (--upload), signed with the
# Apple account in Xcode; nothing is built in CI.

default_platform(:ios)

ROOT = File.expand_path("../..", __dir__)
STORE = File.join(ROOT, "store/ios")

def api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH")
  )
end

platform :ios do
  desc "Uploads the store texts and screenshots, without a build or review"
  lane :metadata do
    deliver(
      api_key: api_key,
      metadata_path: File.join(STORE, "metadata"),
      screenshots_path: File.join(STORE, "screenshots"),
      overwrite_screenshots: true,
      skip_binary_upload: true,
      submit_for_review: false,
      force: true,
      precheck_include_in_app_purchases: false
    )
  end
end
